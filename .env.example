# ============================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG CHO MẠ STORY AI (VERCEL & LOCAL)
# Sao chép tệp này thành .env khi chạy local, hoặc nhập trực tiếp
# vào Vercel Dashboard > Project Settings > Environment Variables
# ============================================================

# 1. Thông số từ Firebase Console > Project Settings > Your apps (Web)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# 2. Danh sách email quản trị viên dự phòng (cách nhau bằng dấu phẩy)
# Khuyến nghị kết hợp với collection `adminUsers` trên Cloud Firestore
VITE_ADMIN_EMAILS=giaovien.tadung@gmail.com

# 3. Khóa Gemini API (CHỈ dùng ở Server / Vercel Serverless Function /api/gemini)
# KHÔNG đặt tiền tố VITE_ để tránh lộ khóa ra trình duyệt người dùng
GEMINI_API_KEY=your_gemini_api_key
